#!/bin/bash
# FAIRe Metadata Filler – macOS app bundle launcher
# Rewrites PATH so all common Python installs are visible to a double-clicked app.

# ── 1. Expand PATH (macOS strips it to /usr/bin when launching .app bundles) ──
export PATH="\
/opt/homebrew/bin:\
/opt/homebrew/opt/python@3.12/bin:\
/opt/homebrew/opt/python@3.11/bin:\
/opt/homebrew/opt/python@3.10/bin:\
/usr/local/bin:\
/usr/local/opt/python@3.12/bin:\
/usr/local/opt/python@3.11/bin:\
/opt/local/bin:\
$HOME/.pyenv/shims:\
$HOME/.pyenv/bin:\
$HOME/miniforge3/bin:\
$HOME/opt/anaconda3/bin:\
$HOME/anaconda3/bin:\
$HOME/miniconda3/bin:\
$HOME/.local/bin:\
/usr/bin:/bin:/usr/sbin:/sbin"

# ── 2. Locate the tool directory (server.py lives next to the .app bundle) ──
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BUNDLE_DIR="$(dirname "$(dirname "$SCRIPT_DIR")")"
TOOL_DIR="$(dirname "$BUNDLE_DIR")"

if [ ! -f "$TOOL_DIR/server.py" ]; then
    osascript -e "display alert \"FAIRe Filler – setup problem\" \
message \"Could not find server.py.\n\nExpected location:\n$TOOL_DIR/server.py\n\nKeep the app in the same folder as server.py.\" \
buttons {\"OK\"} default button \"OK\""
    exit 1
fi
cd "$TOOL_DIR"

# ── 3. Remove quarantine added by OneDrive / browser downloads ────────────────
xattr -cr "$BUNDLE_DIR" 2>/dev/null || true

# ── 4. Find Python 3.9+ across all common install locations ──────────────────
PYTHON=""
for candidate in \
        python3.12 python3.11 python3.10 python3.9 python3 python \
        /opt/homebrew/bin/python3 \
        /usr/local/bin/python3 \
        "$HOME/miniforge3/bin/python3" \
        "$HOME/opt/anaconda3/bin/python3" \
        "$HOME/anaconda3/bin/python3" \
        "$HOME/miniconda3/bin/python3"; do
    if command -v "$candidate" &>/dev/null || [ -x "$candidate" ]; then
        VER=$("$candidate" -c "import sys; print(sys.version_info[:2] >= (3,9))" 2>/dev/null)
        if [ "$VER" = "True" ]; then
            PYTHON="$candidate"
            break
        fi
    fi
done

if [ -z "$PYTHON" ]; then
    osascript << 'AS'
tell application "System Events"
    set answer to button returned of (display alert "Python 3.9+ not found" ¬
        message "Please install Python from python.org/downloads, then double-click the app again.

Tip: tick "Add Python to PATH" during the Windows installer, or use the default macOS installer." ¬
        buttons {"Open python.org", "OK"} default button "OK")
    if answer is "Open python.org" then
        tell application "Safari" to open location "https://www.python.org/downloads/"
    end if
end tell
AS
    exit 1
fi

# ── 5. Log startup info (helps diagnose problems) ────────────────────────────
LOG="$TOOL_DIR/faire_startup.log"
{
    echo "=== $(date) ==="
    echo "Python  : $PYTHON"
    echo "Version : $("$PYTHON" --version 2>&1)"
    echo "Workdir : $TOOL_DIR"
} > "$LOG"

# ── 6. Install / update dependencies silently ─────────────────────────────────
"$PYTHON" -m pip install --quiet --upgrade pystray pillow pdfplumber anthropic >> "$LOG" 2>&1 || true

# ── 7. Launch (tray app opens browser automatically) ─────────────────────────
exec "$PYTHON" tray_app.py >> "$LOG" 2>&1
